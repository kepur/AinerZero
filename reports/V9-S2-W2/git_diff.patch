+def _find_checkpoint(output_root: Path | str, arm: str, seed: int) -> Path:
+    root = Path(output_root)
+    candidates = [
+        root / "checkpoints" / str(arm) / str(int(seed)) / "best.ckpt",
+        root / "checkpoints" / str(arm) / str(int(seed)) / "best.npz",
+        root / "checkpoints" / str(arm) / f"seed{seed}" / "best.ckpt",
+        root / "checkpoints" / str(arm) / f"seed{seed}" / "best.npz",
+        root / str(arm) / str(int(seed)) / "best.ckpt",
+        root / str(arm) / str(int(seed)) / "best.npz",
+        root / str(arm) / f"seed{seed}" / "best.ckpt",
+        root / str(arm) / f"seed{seed}" / "best.npz",
+        root / "best.ckpt",
+        root / "best.npz",
+    ]
+    norm = arm.lower().replace("-", "_")
+    short = norm.removeprefix("arm_") if norm.startswith("arm_") else norm
+    candidates.extend([
+        root / "checkpoints" / short / str(int(seed)) / "best.ckpt",
+        root / "checkpoints" / short / str(int(seed)) / "best.npz",
+        root / short / str(int(seed)) / "best.ckpt",
+        root / short / str(int(seed)) / "best.npz",
+    ])
+    for cand in candidates:
+        if cand.is_file():
+            return cand
+    raise FileNotFoundError(f"Checkpoint for arm={arm}, seed={seed} not found under {output_root}")
+
