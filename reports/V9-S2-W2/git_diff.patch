+def _extract_expected_sha(ledger: Any, arm: str, seed: int) -> str | None:
+    if ledger is None:
+        return None
+    if isinstance(ledger, str):
+        if len(ledger) == 64 and all(c in "0123456789abcdefABCDEF" for c in ledger):
+            return ledger
+        p = Path(ledger)
+        if p.is_file():
+            try:
+                data = json.loads(p.read_text(encoding="utf-8"))
+                return _extract_expected_sha(data, arm, seed)
+            except Exception:
+                pass
+    if isinstance(ledger, dict):
+        if (arm, seed) in ledger:
+            val = ledger[(arm, seed)]
+            return val if isinstance(val, str) else val.get("checkpoint_sha256") or val.get("sha256")
+        if (arm, int(seed)) in ledger:
+            val = ledger[(arm, int(seed))]
+            return val if isinstance(val, str) else val.get("checkpoint_sha256") or val.get("sha256")
+        if f"{arm}:{seed}" in ledger:
+            val = ledger[f"{arm}:{seed}"]
+            return val if isinstance(val, str) else val.get("checkpoint_sha256") or val.get("sha256")
+        if f"{arm}_{seed}" in ledger:
+            val = ledger[f"{arm}_{seed}"]
+            return val if isinstance(val, str) else val.get("checkpoint_sha256") or val.get("sha256")
+        if arm in ledger and isinstance(ledger[arm], dict):
+            sub = ledger[arm]
+            if seed in sub:
+                val = sub[seed]
+                return val if isinstance(val, str) else val.get("checkpoint_sha256") or val.get("sha256")
+            if str(seed) in sub:
+                val = sub[str(seed)]
+                return val if isinstance(val, str) else val.get("checkpoint_sha256") or val.get("sha256")
+        if "checkpoint_sha256" in ledger:
+            return ledger["checkpoint_sha256"]
+        if "sha256" in ledger:
+            return ledger["sha256"]
+    return None
+
+
+def load_trained_model(
+    output_root: Path | str,
+    arm: str,
+    seed: int,
+    *,
+    ledger: Any = None,
+    counter: ForwardCounter | None = None,
+    model_factory: Callable[..., Any] | None = None,
+) -> Any:
+    """Load a trained arm model from checkpoint, strictly verifying sha integrity."""
+    ckpt_path = _find_checkpoint(output_root, arm, seed)
+    actual_sha = _sha256_file(ckpt_path)
+
+    expected_sha = _extract_expected_sha(ledger, arm, seed)
+    meta_path = ckpt_path.parent / "meta.json"
+    meta_sha = None
+    if meta_path.is_file():
+        try:
+            meta_data = json.loads(meta_path.read_text(encoding="utf-8"))
+            meta_sha = meta_data.get("checkpoint_sha256")
+        except Exception:
+            pass
+
+    if expected_sha is None and meta_sha is None:
+        raise ValueError(
+            f"Checkpoint integrity verification failed: no expected sha found in ledger or meta.json for {ckpt_path}"
+        )
+
+    if expected_sha is not None and actual_sha != expected_sha:
+        raise ValueError(
+            f"Checkpoint sha mismatch against ledger for {arm} seed={seed}: expected {expected_sha}, got {actual_sha}"
+        )
+
+    if meta_sha is not None and actual_sha != meta_sha:
+        raise ValueError(
+            f"Checkpoint sha mismatch against meta.json for {arm} seed={seed}: expected {meta_sha}, got {actual_sha}"
+        )
+
+    if model_factory is not None:
+        try:
+            model = model_factory(arm, counter=counter)
+        except TypeError:
+            model = model_factory(arm)
+    else:
+        model = make_mlx_arm(arm, counter=counter)
+
+    model.load(ckpt_path)
+    return model
+
+
