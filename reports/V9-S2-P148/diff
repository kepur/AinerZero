+
+# ==============================================================================
+# 2. Verify Mode Three Cases
+# ==============================================================================
+
+
+def test_verify_case_unfrozen_when_prereg_missing(tmp_path: Path) -> None:
+    """Case 1: When prereg.json does not exist, verify returns unfrozen (未冻结)."""
