+        f"{HERE}/run_s5p1.py",
+        "    return cells\n",
+        "    return [{\n"
+        "        'cell_id': 'smoke-A0-L64', 'kind': 'supervised', 'arm': 'A0', 'seed': 0,\n"
+        "        'lr': 1e-3, 'label_n': 64, 'epochs': 2, 'batch_size': 8, 'n_clips': 16,\n"
+        "        'steps': 4, 'partition': SMOKE_PARTITIONS['lab'],\n"
+        "    }]\n",
