+def test_label_n_subset_is_used_in_supervised_cell(tmp_path: Path):
+    from ainerzero.v9.experiments.s5.data import ClipIndex
+
+    root = _make_root(tmp_path)
+    _setup_single_l64_cell_in_copy(root)
