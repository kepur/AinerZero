+    """Retrieve run metrics from RunStore metadata or reason column."""
+    with store._transaction() as db:
+        row = db.execute(
+            "SELECT value FROM metadata WHERE key = ?",
+            (f"run:{run_id}:metrics",),
+        ).fetchone()
+        if row:
+            try:
+                return json.loads(row[0])
