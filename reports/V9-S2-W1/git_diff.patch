+def _resolve_smoke_train_steps(ledger_path: Path | str) -> int | None:
+    """Resolve shared_train_steps from the most recent completed passed smoke run in SQLite ledger."""
+    p = Path(ledger_path)
+    if not p.is_file():
+        return None
+    try:
+        conn = sqlite3.connect(str(p), timeout=10)
+        conn.row_factory = sqlite3.Row
+        try:
+            cursor = conn.execute(
+                "SELECT run_id, state, config_json, created_at, updated_at "
+                "FROM runs ORDER BY updated_at DESC, created_at DESC"
+            )
+            for row in cursor.fetchall():
+                try:
+                    cfg = json.loads(row["config_json"])
+                except Exception:
+                    continue
+                if cfg.get("mode") != "smoke":
+                    continue
+                # Most recent smoke run: must be completed and passed
+                if row["state"] != "completed":
+                    return None
+                if not (cfg.get("passed") is True or cfg.get("status") == "completed"):
+                    return None
+                shared_steps = cfg.get("shared_train_steps")
+                if shared_steps is None:
+                    shared_steps = cfg.get("timing_and_steps", {}).get("shared_train_steps")
+                if shared_steps is not None and int(shared_steps) > 0:
+                    return int(shared_steps)
+                return None
+            return None
+        finally:
+            conn.close()
+    except Exception:
+        return None
+
