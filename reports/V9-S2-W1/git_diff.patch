+def get_holdout_world_indices(
+    train_root: Path,
+    n_worlds: int | None = None,
+    holdout_fraction: float | None = None,
+) -> set[int]:
+    """Retrieve or compute holdout world indices for train partition (DESIGN-r2 Appendix D1/D2)."""
+    holdout_file = train_root / "HOLDOUT_WORLDS.json"
+    if holdout_file.is_file():
+        try:
+            data = json.loads(holdout_file.read_text(encoding="utf-8"))
+            return set(int(w) for w in data.get("holdout_worlds", []))
+        except Exception:
+            pass
+
+    # Extract existing world directories
+    world_dirs = [d for d in train_root.iterdir() if d.is_dir() and d.name.startswith("world_")]
+    world_indices = []
+    for d in world_dirs:
+        try:
+            world_indices.append(int(d.name.split("_")[1]))
+        except ValueError:
+            pass
+    world_indices.sort()
+
+    total_w = n_worlds if n_worlds is not None else (len(world_indices) if world_indices else int(spec.TRAIN_N_WORLDS))
+    if total_w <= 0:
+        return set()
+    all_w = world_indices if world_indices else list(range(total_w))
+    frac = float(spec.TRAIN_HOLDOUT_WORLD_FRACTION) if holdout_fraction is None else float(holdout_fraction)
+    ranked = sorted(
+        all_w,
+        key=lambda w: hashlib.sha256(f"s2p1-train-v1|holdout|{w}".encode("utf-8")).hexdigest(),
+    )
+    n_hold = max(1, int(round(len(all_w) * frac)))
+    return set(ranked[:n_hold])
+
