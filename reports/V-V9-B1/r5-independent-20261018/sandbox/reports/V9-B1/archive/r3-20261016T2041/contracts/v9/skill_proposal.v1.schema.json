{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ainerzero:v9/skill_proposal.v1",
  "title": "SkillProposal/v1（reports/V9-B1/COORDINATOR_DECISIONS.md 裁决 1–11）",
  "description": "世界脑经分层规划产出的提案，唯一入口是 AWZ 能力门禁。v1 只开运行路线：提案引用 ability_id，路由（运行/编辑）与效果类别由 AWZ 能力登记条目的 effect_class 推导，提案自身不声明路由，也不声明效果类别。目标只用所依据 ObservationPacket/v1.1 里的检测句柄 h-<n>，或用智能体自身坐标系下的相对位姿加不确定性；任何世界侧标识字段都不允许出现。evidence_version 是 basis 的 RFC 8785（JCS）摘要，门禁重算，不一致即拒。schema 只做结构；句柄解析、能力登记核对、TTL 判断与幂等由报告目录参考核对及未来 AWZ 门禁实现负责。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "actor",
    "basis",
    "evidence_version",
    "ability_id",
    "params",
    "targets",
    "action_budget",
    "ttl_ticks",
    "expected_outcomes"
  ],
  "dependentRequired": {
    "calibration": [
      "confidence"
    ],
    "confidence": [
      "calibration"
    ]
  },
  "properties": {
    "schema_version": {
      "const": "skill_proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^prop-[a-z0-9][a-z0-9-]{2,63}$",
      "description": "在（回合、actor）内唯一；同 ID 同摘要返回原决定，同 ID 不同摘要为 duplicate_proposal（裁决 10）。"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "evidence_version": {
      "$ref": "#/$defs/sha256",
      "description": "basis 的 JCS（RFC 8785）摘要，小写十六进制；门禁重算，不一致即 evidence_mismatch（裁决 3）。"
    },
    "ability_id": {
      "type": "string",
      "pattern": "^abil-[a-z0-9][a-z0-9_.-]{2,63}$",
      "description": "必须在 AWZ 能力登记表里；未登记即 ability_unknown（裁决 5）。"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "not": {
          "$ref": "#/$defs/world_id_key"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/param_value"
      },
      "description": "按登记条目的 param_schema 校验；结构本身必须只含可观察量，禁止世界侧标识键（裁决 2、5）。"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "description": "只允许句柄目标或自身坐标系下的相对位姿目标；句柄必须在所依据的包里、未因遮挡重发失效、且世界侧可解析（裁决 2）。"
    },
    "action_budget": {
      "$ref": "#/$defs/action_budget"
    },
    "ttl_ticks": {
      "type": "integer",
      "minimum": 1,
      "description": "有效窗为 [basis.t_ticks, basis.t_ticks + ttl_ticks]（含两端）；上限由能力登记条目 max_ttl_ticks 给出（裁决 4）。"
    },
    "expected_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expected_outcome"
      },
      "description": "对未来观察的预测，只用于事后比对学习进展与好奇心；不得写世界真值字段、事件类型或隐藏接触（裁决 7）。"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "只作参考，不作任何门禁依据；调到 1.0 也不能越过任何一道门（裁决 6）。"
    },
    "calibration": {
      "$ref": "#/$defs/calibration",
      "description": "出现 confidence 时必须声明；uncalibrated 或无登记校准引用都不影响门禁判定（裁决 6）。"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "world_id_key": {
      "description": "世界侧标识键名，任何层级都不允许（裁决 2）。含蛇形与驼峰，以及 hidden_contact。",
      "pattern": "(^|_)(world|entity|scene|event|instance|landmark|object|actor|agent|truth|hidden)_?ids?$|^ids?$|([Ww]orld|[Ee]ntity|[Ss]cene|[Ee]vent)[Ii][Dd]s?$|[Hh]idden_?[Cc]ontact$"
    },
    "param_value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param_value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "$ref": "#/$defs/world_id_key"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_value"
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "agent_id",
        "policy_revision"
      ],
      "description": "世界脑的运行与智能体身份。门禁从会话取 actor，自带 actor 与会话不符即拒（裁决 10）；这只是世界侧日志的拒绝原因。",
      "properties": {
        "kind": {
          "const": "world_brain"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run-[a-z0-9][a-z0-9-]{2,63}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^agent-[a-z0-9]{4,32}$"
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "time_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "episode_id",
        "epoch_id",
        "tick_hz"
      ],
      "description": "与 docs/v9/TEACHERS_AND_CACHE.md r3 的 observation_time_domain 同口径。与当前回合不一致直接拒，不做换算（裁决 4）。",
      "properties": {
        "clock": {
          "const": "episode_relative"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "tick_hz": {
          "const": 120
        }
      }
    },
    "observation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^awz://observation/[A-Za-z0-9][A-Za-z0-9._~/-]*$",
          "not": {
            "pattern": "(^|/)(private|truth|eval|future)(/|$)"
          },
          "description": "只许允许的命名空间，且按截至本包 t_ticks 解析（ARCHITECTURE_V9 §8.6，F2）。"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "brain_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version",
        "encoder_version",
        "planner_version"
      ],
      "properties": {
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "encoder_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "planner_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_ref",
        "t_ticks",
        "time_domain",
        "belief_sha256",
        "brain"
      ],
      "description": "提案所依据的观察与信念（裁决 3）；evidence_version 即本对象的 JCS 摘要。",
      "properties": {
        "packet_ref": {
          "$ref": "#/$defs/observation_ref"
        },
        "t_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "time_domain": {
          "$ref": "#/$defs/time_domain"
        },
        "belief_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "brain": {
          "$ref": "#/$defs/brain_versions"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sigma"
      ],
      "description": "不确定性必须严格为正：0 等于声称知道真值。",
      "properties": {
        "sigma": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "handle"
          ],
          "properties": {
            "kind": {
              "const": "handle"
            },
            "handle": {
              "type": "string",
              "pattern": "^h-[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rel_position_m",
            "uncertainty"
          ],
          "properties": {
            "kind": {
              "const": "ego_relative_pose"
            },
            "rel_position_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "rel_yaw_deg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            },
            "uncertainty": {
              "$ref": "#/$defs/uncertainty"
            }
          }
        }
      ]
    },
    "action_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_duration_ticks"
      ],
      "description": "提案自己声明的动作数与持续时长上限；门禁与登记条目的 max_actions / max_duration_ticks 比对（裁决 5）。",
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_ticks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outcome_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_offset_ticks",
        "end_offset_ticks"
      ],
      "description": "相对 basis.t_ticks 的 tick 偏移窗，闭区间；语义约束 0 <= start <= end <= ttl_ticks 由门禁核对（裁决 7）。",
      "properties": {
        "start_offset_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset_ticks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "quantity",
        "predicted_value",
        "uncertainty",
        "window"
      ],
      "properties": {
        "channel": {
          "enum": [
            "symbol8",
            "egocentric_grid",
            "rgb",
            "depth",
            "relative_objects",
            "ego_motion",
            "audio_events",
            "semantic_mask"
          ],
          "description": "只能是 ObservationPacket/v1.1 observation.channels 已有的通道；pose_sensor_if_allowed 不是通道，不在其列。"
        },
        "quantity": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
            },
            {
              "not": {
                "pattern": "(^|\\.)(world_id|entity_id|scene_id|event_id|instance_id|hidden_contact)($|\\.)"
              }
            }
          ],
          "description": "被预测的可观察量名。值本身也不得是世界标识或隐藏接触（裁决 2、7），例如 world_id、hidden_contact。"
        },
        "predicted_value": {
          "type": "number"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "window": {
          "$ref": "#/$defs/outcome_window"
        }
      }
    },
    "calibration": {
      "oneOf": [
        {
          "const": "uncalibrated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calibration_ref"
          ],
          "properties": {
            "calibration_ref": {
              "type": "string",
              "pattern": "^cal-[a-z0-9][a-z0-9_.-]{2,63}$"
            }
          }
        }
      ]
    }
  }
}
