{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ainerzero:v9/skill_gate_reply.v1",
  "title": "SkillGateReply/v1（世界脑可见版，reports/V9-B1/COORDINATOR_DECISIONS.md 裁决 8、10）",
  "description": "AWZ 能力门禁回给世界脑的唯一通道。只含白名单原因码与公开回显字段；世界侧的完整决定（含解析到的实体、命中哪一条隐藏状态）只写入世界侧日志，永不出现在本文件。执行结果不在这里回传，只能通过之后的观察获得。任何非白名单原因码、任何世界侧标识字段都必须被本 schema 拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "evidence_version",
    "decision",
    "reason_code",
    "decided_at_tick",
    "valid_until_tick"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "accepted"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "$ref": "#/$defs/rejected_reason_code"
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "skill_gate_reply.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^prop-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "evidence_version": {
      "$ref": "#/$defs/sha256",
      "description": "原样回显提案的 evidence_version；门禁从不改写提案（裁决 9），所以这里必须与提交值逐字节相同。"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "reason_code": {
      "$ref": "#/$defs/visible_reason_code"
    },
    "decided_at_tick": {
      "type": "integer",
      "minimum": 0,
      "description": "门禁据以判断的当前回合 tick（裁决 4：按 tick 计，不用墙钟）。"
    },
    "valid_until_tick": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "basis.t_ticks + ttl_ticks，即有效窗闭区间右端；提案结构本身不可用时为 null。这是提案自带的公开量，不泄露世界侧状态。"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visible_reason_code": {
      "description": "裁决 8 的白名单：schema_invalid、ability_unknown、params_invalid、budget_exceeded、proposal_expired、time_domain_mismatch、evidence_mismatch、handle_unknown、effect_class_not_registered、duplicate_proposal，外加 accepted。同一条裁决要求把会暴露隐藏状态的原因（目标在墙后、对象其实已不存在等）折叠成 handle_unknown 或 rejected_other，因此 rejected_other 是白名单里的折叠桶，不是自由文本。枚举是封闭的：任何其他原因码都必须被拒。",
      "enum": [
        "accepted",
        "schema_invalid",
        "ability_unknown",
        "params_invalid",
        "budget_exceeded",
        "proposal_expired",
        "time_domain_mismatch",
        "evidence_mismatch",
        "handle_unknown",
        "effect_class_not_registered",
        "duplicate_proposal",
        "rejected_other",
        "target_behind_wall",
        "object_no_longer_exists"
      ]
    },
    "rejected_reason_code": {
      "description": "被拒时的取值：白名单去掉 accepted。decision 与 reason_code 必须一致，accepted 不能配任何被拒原因码，rejected 也不能配 accepted。",
      "enum": [
        "schema_invalid",
        "ability_unknown",
        "params_invalid",
        "budget_exceeded",
        "proposal_expired",
        "time_domain_mismatch",
        "evidence_mismatch",
        "handle_unknown",
        "effect_class_not_registered",
        "duplicate_proposal",
        "rejected_other",
        "target_behind_wall",
        "object_no_longer_exists"
      ]
    }
  }
}
