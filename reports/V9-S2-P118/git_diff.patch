+def test_flat_near_goal_success_rate():
+    start, goal = NEAR_START, NEAR_GOAL
+    assert 1 <= shortest_path_len(start, goal) <= NEAR_MAX_STEPS
+    # Execute the planned horizon open-loop (n_exec=H); still CEM-planned.
+    cfg = FlatCEMConfig(
+        horizon=8,
+        n_iters=8,
+        pop_size=64,
+        elite_frac=0.3,
