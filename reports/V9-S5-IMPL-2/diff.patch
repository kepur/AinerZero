@@ -0,0 +1,186 @@
+"""S5 Tubelet Patches 与 RLT 接口模块（纯 NumPy）。
+
+实现规范：
+- `tubelet_patches`：管长 2、块 16，展平顺序为（管长内帧, 块行, 块列, 通道），像素值归一化至 [0, 1] float32。
+  时空 token 顺序为 (t, h, w)，与 V-JEPA 2.1 源码（`PatchEmbed3D.__call__`，行 110-115）严格一致。
+- `rlt_keep`：权威接入 `ainerzero.v9.tokenization.rlt.rlt_frame_dropping`。
+  返回 `(keep, run_len)`，保留位置记录代表管长数，被并掉位置记 0。
+- `restoration_error`：统计被并掉的块与其所并入 token 的 ‖·‖∞ 分布，返回 (median, p95)。
+"""
+from __future__ import annotations
+
+from typing import NamedTuple
+import numpy as np
+
+from ainerzero.v9.tokenization.rlt import rlt_frame_dropping
+
+TUBELET_SIZE: int = 2
+PATCH_SIZE: int = 16
+FRAMES: int = 16
+HEIGHT: int = 224
+WIDTH: int = 224
+CHANNELS: int = 3
+
+NUM_TUBES: int = FRAMES // TUBELET_SIZE      # 8
+GRID_H: int = HEIGHT // PATCH_SIZE           # 14
+GRID_W: int = WIDTH // PATCH_SIZE            # 14
+PATCH_DIM: int = TUBELET_SIZE * PATCH_SIZE * PATCH_SIZE * CHANNELS  # 1536
+
+
+class RestorationError:
+    def __init__(self, median: float, p95: float):
+        self.median = float(median)
+        self.p95 = float(p95)
+
+    def __iter__(self):
+        yield self.median
+        yield self.p95
+
+    def __getitem__(self, idx):
+        if idx == 0 or idx == "median":
+            return self.median
+        if idx == 1 or idx == "p95":
+            return self.p95
+        raise IndexError(idx)
+
+    def __repr__(self) -> str:
+        return f"RestorationError(median={self.median}, p95={self.p95})"
+
+    def __eq__(self, other) -> bool:
+        if isinstance(other, (RestorationError, tuple, list)):
+            return tuple(self) == tuple(other)
+        return False
+
+
+def tubelet_patches(clip_uint8: np.ndarray) -> np.ndarray:
+    """将视频切片 [16, 224, 224, 3] 转换为时空 Tubelet 块 [8, 14, 14, 1536]。
+
+    支持单 clip 或带批次维 [B, 16, 224, 224, 3]。
+    展平顺序内部为：(dt, dh, dw, c)，外部为 (t, h, w)。
+    """
+    has_batch = (clip_uint8.ndim == 5)
+    if not has_batch and clip_uint8.ndim != 4:
+        raise ValueError(f"Expected 4D or 5D input, got {clip_uint8.ndim}D")
+
+    clip = clip_uint8 if has_batch else clip_uint8[np.newaxis, ...]
+    B, T, H, W, C = clip.shape
+
+    if (T, H, W, C) != (FRAMES, HEIGHT, WIDTH, CHANNELS):
+        raise ValueError(
+            f"Expected shape (*, {FRAMES}, {HEIGHT}, {WIDTH}, {CHANNELS}), got {clip.shape}"
+        )
+
+    # 1. 拆分网格与管长
+    # (B, 8, 2, 14, 16, 14, 16, 3)
+    reshaped = clip.reshape(
+        B,
+        NUM_TUBES,
+        TUBELET_SIZE,
+        GRID_H,
+        PATCH_SIZE,
+        GRID_W,
+        PATCH_SIZE,
+        CHANNELS,
+    )
+
+    # 2. 转置为 (B, t, h, w, dt, dh, dw, c)
+    transposed = reshaped.transpose(0, 1, 3, 5, 2, 4, 6, 7)
+
+    # 3. 展平成 (B, 8, 14, 14, 1536) 并归一化到 float32 [0, 1]
+    patches = transposed.reshape(B, NUM_TUBES, GRID_H, GRID_W, PATCH_DIM).astype(np.float32) / 255.0
+
+    return patches if has_batch else patches[0]
+
+
+def rlt_keep(
+    patches: np.ndarray, tau: float
+) -> tuple[np.ndarray, np.ndarray]:
+    """对 patches [8, 14, 14, 1536] 执行 RLT frame dropping（权威调用 rlt.py）。
+
+    返回：
+        keep: bool [8, 14, 14] 保留掩码
+        run_len: int [8, 14, 14] 游程长度（保留处为 1..8，被并掉处为 0）
+    """
+    has_batch = (patches.ndim == 5)
+    if not has_batch and patches.ndim != 4:
+        raise ValueError(f"Expected 4D or 5D input, got {patches.ndim}D")
+
+    arr = patches if has_batch else patches[np.newaxis, ...]
+    B, T, H, W, D = arr.shape
+
+    all_keep = []
+    all_run_len = []
+
+    for b in range(B):
+        # 权威模块输入要求: [T, ph, pw, D]
+        chunk = arr[b]  # [8, 14, 14, 1536]
+        retained, run_lengths, positions, restoration, rate = rlt_frame_dropping(
+            chunk, tau
+        )
+
+        keep_mask = np.zeros((T, H, W), dtype=bool)
+        run_len_mask = np.zeros((T, H, W), dtype=int)
+
+        # 还原 keep_mask 与 run_len_mask：
+        # rlt_frame_dropping 中，第一帧始终为 True
+        # 随后的 t >= 1 只有在 diff_max >= tau 时保留
+        # 根据 positions 和 run_lengths 填回
+        # 注意 positions 对应每个保留的 token
+        token_idx = 0
+        for pos_idx in range(H * W):
+            h = pos_idx // W
+            w = pos_idx % W
+            # 在当前位置 (h, w)，顺序读取该位置的所有保留 token
+            curr_t = 0
+            while curr_t < T:
+                # 记录保留
+                keep_mask[curr_t, h, w] = True
+                rl = int(run_lengths[token_idx])
+                run_len_mask[curr_t, h, w] = rl
+                token_idx += 1
+                curr_t += rl
+
+        all_keep.append(keep_mask)
+        all_run_len.append(run_len_mask)
+
+    keep_res = np.stack(all_keep, axis=0)
+    run_len_res = np.stack(all_run_len, axis=0)
+
+    return (keep_res, run_len_res) if has_batch else (keep_res[0], run_len_res[0])
+
+
+def restoration_error(
+    patches: np.ndarray, keep: np.ndarray
+) -> RestorationError:
+    """计算被并掉的块与它所并入 anchor token 之间的 ‖·‖∞ 分布。
+
+    返回:
+        RestorationError(median, p95)
+    """
+    has_batch = (patches.ndim == 5)
+    arr = patches if has_batch else patches[np.newaxis, ...]
+    k_arr = keep if has_batch else keep[np.newaxis, ...]
+    B, T, H, W, D = arr.shape
+
+    errors: list[float] = []
+
+    for b in range(B):
+        for h in range(H):
+            for w in range(W):
+                anchor_vec = None
+                for t in range(T):
+                    if k_arr[b, t, h, w]:
+                        anchor_vec = arr[b, t, h, w]
+                    else:
+                        assert anchor_vec is not None, "First frame must be kept"
+                        # ‖·‖∞ 范数: max(|p_t - anchor|)
+                        diff_inf = float(np.max(np.abs(arr[b, t, h, w] - anchor_vec)))
+                        errors.append(diff_inf)
+
+    if not errors:
+        return RestorationError(0.0, 0.0)
+
+    errs = np.array(errors, dtype=np.float64)
+    med = float(np.median(errs))
+    p95 = float(np.percentile(errs, 95))
+    return RestorationError(med, p95)
diff --git a/src/ainerzero/v9/experiments/s5/student.py b/src/ainerzero/v9/experiments/s5/student.py
new file mode 100644
index 0000000..d20753a
--- /dev/null
+++ b/src/ainerzero/v9/experiments/s5/student.py
@@ -0,0 +1,184 @@
+"""S5 学生时空 ViT 编码器模块（MLX）。
+
+结构规范：
+- `Student(d=192, depth=6, heads=3)`
+  - 输入：patches [B, 8, 14, 14, 1536] 或 [B, 1568, 1536]
+  - 可选参数：keep [B, 8, 14, 14] 与 run_len [B, 8, 14, 14]
+  - 线性嵌入：nn.Linear(1536, d)
+  - 1568 个可学位置嵌入：self.pos (形状 [1568, d])
+  - 游程长度嵌入：self.run_len_embed (长度 1..8，初始化为全 0，只在给了 keep 时加)
+  - 6 层前置 LayerNorm 的 Transformer 块，最后 LayerNorm
+  - 输出：tokens [B, 1568, d] 和 mask [B, 1568]
+  - 被并掉的 token 不进注意力：按批内最大保留数补齐，再用注意力掩码
+- `features(layer=k)`：取第 k 层后的 token，给对齐损失使用
+- 全保留时，带 keep 和不带 keep 的输出逐元素一致，误差 < 1e-5
+"""
+from __future__ import annotations
+
+import mlx.core as mx
+import mlx.nn as nn
+import numpy as np
+
+
+class TransformerBlock(nn.Module):
+    """前置 LayerNorm 的 Transformer 编码器块。"""
+
+    def __init__(self, d: int, heads: int):
+        super().__init__()
+        self.n1 = nn.LayerNorm(d)
+        self.attn = nn.MultiHeadAttention(d, heads)
+        self.n2 = nn.LayerNorm(d)
+        self.mlp = nn.Sequential(
+            nn.Linear(d, 4 * d),
+            nn.GELU(),
+            nn.Linear(4 * d, d),
+        )
+
+    def __call__(self, x: mx.array, mask: mx.array | None = None) -> mx.array:
+        h = self.n1(x)
+        x = x + self.attn(h, h, h, mask=mask)
+        return x + self.mlp(self.n2(x))
+
+
+class Student(nn.Module):
+    """学生端时空 ViT 模型。"""
+
+    def __init__(
+        self,
+        d: int = 192,
+        depth: int = 6,
+        heads: int = 3,
+        num_tokens: int = 1568,
+        patch_dim: int = 1536,
+    ):
+        super().__init__()
+        self.d = d
+        self.depth = depth
+        self.heads = heads
+        self.num_tokens = num_tokens
+
+        self.embed = nn.Linear(patch_dim, d)
+        # 1568 个可学位置嵌入
+        self.pos = mx.random.normal((num_tokens, d)) * 0.02
+        # 可学游程长度嵌入 1..8（索引 0 保留不用；初始化为 0 保证初始时与不加完全等价）
+        self.run_len_embed = mx.zeros((9, d))
+
+        self.blocks = [TransformerBlock(d, heads) for _ in range(depth)]
+        self.norm = nn.LayerNorm(d)
+
+        # 缓存每层中间特征供 features() 访问
+        self._layer_features: list[mx.array] = []
+        self._last_mask: mx.array | None = None
+
+    def __call__(
+        self,
+        patches: mx.array,
+        keep: mx.array | None = None,
+        run_len: mx.array | None = None,
+    ) -> tuple[mx.array, mx.array]:
+        """前向传播。
+
+        参数:
+            patches: [B, 8, 14, 14, 1536] 或 [B, 1568, 1536]
+            keep: 可选 [B, 8, 14, 14] 或 [B, 1568] 布尔保留掩码
+            run_len: 可选 [B, 8, 14, 14] 或 [B, 1568] 整数游程长度
+
+        返回:
+            tokens: [B, 1568, d]
+            mask: [B, 1568] 布尔掩码
+        """
+        B = patches.shape[0]
+        if patches.ndim == 5:
+            # [B, 8, 14, 14, 1536] -> [B, 1568, 1536]
+            patches = patches.reshape(B, self.num_tokens, -1)
+
+        # 1. 线性嵌入与位置编码
+        x = self.embed(patches) + self.pos  # [B, 1568, d]
+
+        # 2. 游程长度嵌入（只在给定了 keep 时加）
+        if keep is not None:
+            mask = keep.reshape(B, self.num_tokens).astype(mx.bool_)
+            if run_len is not None:
+                rl = mx.clip(run_len.reshape(B, self.num_tokens), 0, 8)
+                x = x + self.run_len_embed[rl]
+        else:
+            mask = mx.ones((B, self.num_tokens), dtype=mx.bool_)
+
+        self._last_mask = mask
+        self._layer_features = []
+
+        # 3. 检查是否全量保留
+        # 若所有样本全保留，则直接执行全序列自注意力
+        is_all_kept = bool(mx.all(mask).item())
+
+        if is_all_kept:
+            curr_h = x
+            for block in self.blocks:
+                curr_h = block(curr_h, mask=None)
+                self._layer_features.append(curr_h)
+            out_tokens = self.norm(curr_h)
+            return out_tokens, mask
+
+        # 4. 稀疏保留分支：按批内最大保留数补齐，不保留的 token 不进注意力
+        mask_np = np.array(mask)
+        indices_list = [np.where(mask_np[b])[0] for b in range(B)]
+        k_counts = [len(idx) for idx in indices_list]
+        k_max = max(k_counts)
+
+        # 聚合紧凑表示 [B, k_max, d]
+        compact_x = mx.zeros((B, k_max, self.d))
+        for b in range(B):
+            if k_counts[b] > 0:
+                compact_x[b, :k_counts[b]] = x[b, mx.array(indices_list[b])]
+
+        # 构造加性注意力掩码 [B, 1, 1, k_max]
+        attn_mask = mx.zeros((B, 1, 1, k_max))
+        for b in range(B):
+            if k_counts[b] < k_max:
+                attn_mask[b, 0, 0, k_counts[b]:] = -1e9
+
+        curr_compact = compact_x
+        for block in self.blocks:
+            curr_compact = block(curr_compact, mask=attn_mask)
+            # 还原至 [B, 1568, d] 并记录层特征
+            layer_tokens = mx.zeros((B, self.num_tokens, self.d))
+            for b in range(B):
+                if k_counts[b] > 0:
+                    layer_tokens[b, mx.array(indices_list[b])] = curr_compact[b, :k_counts[b]]
+            self._layer_features.append(layer_tokens)
+
+        compact_norm = self.norm(curr_compact)
+        out_tokens = mx.zeros((B, self.num_tokens, self.d))
+        for b in range(B):
+            if k_counts[b] > 0:
+                out_tokens[b, mx.array(indices_list[b])] = compact_norm[b, :k_counts[b]]
+
+        return out_tokens, mask
+
+    def features(
+        self,
+        patches: mx.array | None = None,
+        keep: mx.array | None = None,
+        run_len: mx.array | None = None,
+        *,
+        layer: int = -1,
+    ) -> mx.array | tuple[mx.array, mx.array]:
+        """取第 layer 层（1-indexed 或 0-indexed，支持负索引）后的 token 特征。
+
+        重要提示（训练规范）：
+        在训练循环或 mx.value_and_grad 中调用时，必须显式传入 patches 参数：
+        `feat, mask = model.features(patches, keep=keep, layer=k)`。
+        这样可保证反向传播计算图准确建立，避免读取上一次前向留下的旧计算图缓存。
+        不传 patches 的用法仅适用于只读推理或前向后的瞬时核验。
+        """
+        if patches is not None:
+            tokens, mask = self(patches, keep=keep, run_len=run_len)
+            # 解析层索引（1-based 转换为 0-based，负数直接使用）
+            idx = (layer - 1) if layer > 0 else layer
+            return self._layer_features[idx], mask
+
+        if not self._layer_features:
+            raise RuntimeError("No cached features available; call forward first or pass patches.")
+
+        idx = (layer - 1) if layer > 0 else layer
+        return self._layer_features[idx]
