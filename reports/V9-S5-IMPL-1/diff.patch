+            assert "distance_bin" in d and 0 <= d["distance_bin"] < 7
+            assert "distance" in d
+            assert d["distance_group"] in {"< 2", "2–4", "> 4"}
+            assert 0.0 <= d["occlusion_ratio"] <= 1.0 + 1e-5
