+@needs_r2
+def test_real_r2_proposal_drives_the_runner_end_to_end(tmp_path, data):
+    """用磁盘上真实的 r2 proposal.json（而不是测试里拼出来的）整条跑通。T38 之前这里 load_plan 抛 KeyError('intrinsics')。"""
+    plan2 = R.load_plan(R2_PROPOSAL)
