+    dts = np.full(config.horizon, float(spec.PLAN_FUTURE_DT_L1), dtype=np.float64)
+    dts[0] = 1.0
+
+    st = s2_eval._to_state(ep["start"])
+    obs = world.student_obs(layout, st, last_action=world.ACTION_WAIT, dt=1)
+    goal_obs = {
