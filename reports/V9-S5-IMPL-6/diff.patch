+LOCK = REPO / "artifacts/locks/m0-worker.lock"
+RUNS = REPO / "artifacts/v9/s5/runs"
+LEDGER = REPO / "artifacts/v9/s5/dev-uses.json"
+DATA_ROOT = REPO / "artifacts/v9/s5/data"
+TEACHERS = REPO / "artifacts/v9/s5/teachers"
+DEV_MAX_USES = 8
+CELL_LIMIT_S = 45 * 60
+STAGE_LIMIT_S = {
+    "smoke": 15 * 60,
