+                f"本阶段读出头总估算约 {heads_wall_s / 3600.0:.2f} h"
+                + ("（对照设计 §6 的 0.75 h）；" if stage == "dev-distill" else "；")
+                + "待 probe 实测后校准覆盖此估计。"
+            )
+    return summary
