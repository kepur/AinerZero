index 0000000..e78d891
--- /dev/null
+++ b/src/ainerzero/v9/experiments/s5/evaluate.py
@@ -0,0 +1,226 @@
+"""S5 评测汇总。
+
+``evaluate`` 调用 ``train.predict`` 再交给 ``metrics``。``per_world_stat`` 只依赖预测数组，
+供 ``metrics.paired_world_bootstrap`` 在抽到的世界上重算同一指标的差值。世界被抽中多次时，
+段按 ``expand_world_index`` 重复计入。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Callable
+
+import numpy as np
+
+from ainerzero.v9.experiments.s5 import metrics
+from ainerzero.v9.experiments.s5.data import ClipIndex, load_item
+from ainerzero.v9.experiments.s5.tokens import rlt_keep
+
+SCALAR_METRICS = (
+    "r2_ap",
+    "r3_ap",
+    "r2_ap_near",
+    "r2_ap_mid",
+    "r2_ap_far",
+    "r3_ap_near",
+    "r3_ap_mid",
+    "r3_ap_far",
+    "r1_rmse",
+    "r1_rmse_object",
+    "r1_rmse_floor",
+    "ordering_all",
+    "keep_rate",
+)
+
+
+def _reorder_by_world(world_ids: np.ndarray) -> tuple[np.ndarray, np.ndarray, int]:
+    """把段排成按世界连续的块，返回 (新下标, 世界原号, 每世界段数)。"""
+    order_worlds: list[int] = []
+    seen: set[int] = set()
+    for raw in world_ids.tolist():
+        world = int(raw)
+        if world not in seen:
+            seen.add(world)
+            order_worlds.append(world)
+    groups: dict[int, list[int]] = {world: [] for world in order_worlds}
+    for index, raw in enumerate(world_ids.tolist()):
+        groups[int(raw)].append(index)
+    counts = {len(groups[world]) for world in order_worlds}
+    if len(counts) != 1:
+        raise ValueError(f"each world needs the same number of clips, got {counts}")
+    clips_per_world = int(next(iter(counts)))
+    order: list[int] = []
+    for world in order_worlds:
+        order.extend(groups[world])
+    return np.asarray(order, dtype=np.int64), np.asarray(order_worlds, dtype=np.int64), clips_per_world
+
+
+def _take(array: np.ndarray, clips: np.ndarray) -> np.ndarray:
+    return np.asarray(array)[np.asarray(clips, dtype=np.int64)]
+
+
+def _take_list(rows: list[Any], clips: np.ndarray) -> list[Any]:
+    return [rows[int(i)] for i in np.asarray(clips, dtype=np.int64)]
+
+
+def metric_value(ev: dict[str, Any], clips: np.ndarray, metric: str) -> float:
+    """在给定段下标（可重复）上重算一个标量指标。"""
+    if metric not in SCALAR_METRICS:
+        raise ValueError(f"unknown metric {metric!r}; expected one of {SCALAR_METRICS}")
+    clips = np.asarray(clips, dtype=np.int64)
+    if metric == "keep_rate":
+        per_clip = ev.get("keep_rate_per_clip")
+        if per_clip is None:
+            return float("nan")
+        return float(np.mean(_take(per_clip, clips)))
+    if metric == "r2_ap":
+        return float(metrics.grid_ap(_take(ev["r2_logit"], clips), _take(ev["r2"], clips)))
+    if metric == "r3_ap":
+        return float(metrics.grid_ap(_take(ev["r3_logit"], clips), _take(ev["r3"], clips)))
+    if metric.startswith("r2_ap_") or metric.startswith("r3_ap_"):
+        which, _, group = metric.partition("_ap_")
+        scores = _take(ev[f"{which}_logit"], clips)
+        targets = _take(ev[which], clips)
+        grouped = metrics.grid_ap_by_distance(scores, targets)
+        return float(grouped[group])
+    pred_logd = _take(ev["r1_logd"], clips)
+    target_logd = _take(ev["r1_target"], clips)
+    if metric == "r1_rmse":
+        return float(metrics.logd_rmse(pred_logd, target_logd))
+    if metric == "r1_rmse_object":
+        return float(metrics.logd_rmse(pred_logd, target_logd, obj=_take(ev["r1_obj"], clips), split="object"))
+    if metric == "r1_rmse_floor":
+        return float(
+            metrics.logd_rmse(
+                pred_logd,
+                target_logd,
+                sky=_take(ev["r1_sky"], clips),
+                obj=_take(ev["r1_obj"], clips),
+                split="floor",
+            )
+        )
+    pred_last = pred_logd[:, -1]
+    ordering = metrics.ordering_accuracy(
+        pred_last,
+        _take_list(ev["ordering_pairs"], clips),
+        _take_list(ev["disk_groups"], clips),
+    )
+    return float(ordering["all"][1])
+
+
+def paired_group_stat(
+    group_a: list[dict[str, Any]],
+    group_b: list[dict[str, Any]],
+    metric: str,
+) -> Callable[[np.ndarray], float]:
+    """多个种子先在同一批段上各自重算，再取平均，然后做 A 减 B。"""
+    if not group_a or not group_b:
+        raise ValueError("both groups need at least one eval")
+    clips_per_world = int(group_a[0]["clips_per_world"])
+    groups = (*group_a, *group_b)
+    if any(int(ev["clips_per_world"]) != clips_per_world for ev in groups):
+        raise ValueError("clips_per_world mismatch")
+
+    def stat(world_idx: np.ndarray) -> float:
+        clips = metrics.expand_world_index(world_idx, clips_per_world=clips_per_world)
+        mean_a = sum(metric_value(ev, clips, metric) for ev in group_a) / len(group_a)
+        mean_b = sum(metric_value(ev, clips, metric) for ev in group_b) / len(group_b)
+        return float(mean_a - mean_b)
+
+    return stat
+
+
+def per_world_stat(
+    eval_a: dict[str, Any],
+    eval_b: dict[str, Any],
+    metric: str,
+) -> Callable[[np.ndarray], float]:
+    """返回 ``stat(world_idx) = metric(A) - metric(B)``，两边都只在这些世界上重算。
+
+    ``world_idx`` 里的重复世界会经 ``metrics.expand_world_index`` 变成重复的段。
+    """
+    clips_per_world = int(eval_a["clips_per_world"])
+    if int(eval_b["clips_per_world"]) != clips_per_world:
+        raise ValueError("eval_a and eval_b clips_per_world differ")
+
+    def stat(world_idx: np.ndarray) -> float:
+        clips = metrics.expand_world_index(world_idx, clips_per_world=clips_per_world)
+        return float(metric_value(eval_a, clips, metric) - metric_value(eval_b, clips, metric))
+
+    return stat
+
+
+def _summarize(ev: dict[str, Any], threshold: float) -> dict[str, Any]:
+    clips = np.arange(ev["r2"].shape[0], dtype=np.int64)
+    recall_r2 = metrics.disk_recall(ev["r2_logit"], ev["disk_groups"], threshold, "occlusion_group")
+    recall_dist = metrics.disk_recall(ev["r2_logit"], ev["disk_groups"], threshold, "distance_group")
+    ordering = metrics.ordering_accuracy(
+        ev["r1_logd"][:, -1],
+        ev["ordering_pairs"],
+        ev["disk_groups"],
+    )
+    summary = {
+        "r2_ap": metric_value(ev, clips, "r2_ap"),
+        "r3_ap": metric_value(ev, clips, "r3_ap"),
+        "r2_ap_by_distance": metrics.grid_ap_by_distance(ev["r2_logit"], ev["r2"]),
+        "r3_ap_by_distance": metrics.grid_ap_by_distance(ev["r3_logit"], ev["r3"]),
+        "r2_recall_occlusion": recall_r2,
+        "r2_recall_distance": recall_dist,
+        "r1_rmse": metric_value(ev, clips, "r1_rmse"),
+        "r1_rmse_object": metric_value(ev, clips, "r1_rmse_object"),
+        "r1_rmse_floor": metric_value(ev, clips, "r1_rmse_floor"),
+        "ordering_accuracy": ordering,
+        "threshold": float(threshold),
+    }
+    if ev.get("keep_rate_per_clip") is not None:
+        summary["keep_rate"] = float(np.mean(ev["keep_rate_per_clip"]))
+    return summary
+
+
+def evaluate(student: Any, heads: Any, index: ClipIndex, *, tau: float | None = None, threshold: float = 0.5) -> dict[str, Any]:
+    """逐段预测后计算 R1/R2/R3、召回、次序，以及可选的 RLT keep 率。
+
+    返回的预测和标签已按世界排成连续段，``world_ids[k]`` 对应段 ``[k*clips_per_world, (k+1)*clips_per_world)``。
+    """
+    from ainerzero.v9.experiments.s5.train import predict
+
+    predicted = predict(student, heads, index, tau=tau)
+    r1_target, r1_sky, r1_obj = [], [], []
+    r2, r3 = [], []
+    disks, pairs = [], []
+    worlds = []
+    keep_rates = []
+    for i in range(len(index)):
+        item = load_item(index, i)
+        worlds.append(int(item["world"]))
+        r1_target.append(np.asarray(item["r1_logd"]))
+        r1_sky.append(np.asarray(item["r1_sky"]))
+        r1_obj.append(np.asarray(item["r1_obj"]))
+        r2.append(np.asarray(item["r2"]))
+        r3.append(np.asarray(item["r3"]))
+        disks.append(item["disk_groups"])
+        pairs.append(item["ordering_pairs"])
+        if tau is not None:
+            kept, _run_len = rlt_keep(item["patches"], tau)
+            keep_rates.append(float(np.mean(kept)))
+
+    order, world_ids, clips_per_world = _reorder_by_world(np.asarray(worlds, dtype=np.int64))
+    ev: dict[str, Any] = {
+        "r1_logd": np.asarray(predicted["r1_logd"])[order],
+        "r2_logit": np.asarray(predicted["r2_logit"])[order],
+        "r3_logit": np.asarray(predicted["r3_logit"])[order],
+        "r1_target": np.stack(r1_target, axis=0)[order],
+        "r1_sky": np.stack(r1_sky, axis=0)[order],
+        "r1_obj": np.stack(r1_obj, axis=0)[order],
+        "r2": np.stack(r2, axis=0)[order],
+        "r3": np.stack(r3, axis=0)[order],
+        "disk_groups": [disks[int(i)] for i in order],
+        "ordering_pairs": [pairs[int(i)] for i in order],
+        "world_ids": world_ids,
+        "clips_per_world": clips_per_world,
+        "threshold": float(threshold),
+        "tau": tau,
+    }
+    if tau is not None:
+        ev["keep_rate_per_clip"] = np.asarray(keep_rates, dtype=np.float64)[order]
+    ev["metrics"] = _summarize(ev, threshold)
+    return ev
diff --git a/reports/V9-S5-PHASE1/plan_s5p1.py b/reports/V9-S5-PHASE1/plan_s5p1.py
new file mode 100644
index 0000000..6f579a8
--- /dev/null
+++ b/reports/V9-S5-PHASE1/plan_s5p1.py
@@ -0,0 +1,330 @@
+"""S5 冻结前各阶段的格清单、选参、选 A* 与 GT1 功效。纯标准库，不训练。"""
+
+from __future__ import annotations
+
+import math
+
+BATCH = 8
+CLIPS_PER_WORLD = 16
+POOL_WORLDS = 250
+LAB_WORLDS = 128
+DISTILL_EPOCHS = 15
+SUPER_EPOCHS = {64: 300, 512: 60, 2048: 20}
+L_WORLDS = {64: 4, 512: 32, 2048: 128}
+DISTILL_LRS = (3e-4, 1e-3)
+SUPER_LRS = (3e-4, 1e-3)
+ETAS = (0.1, 0.5, 1.0)
+ARM_ORDER = ("A1", "A2", "A3")
+SEG_PER_S = 54.0
+FINAL_WORLD_CAP = 96
+GT1_EFFECT = 0.05
+GT1_LEVEL = 1.0 - 0.05 / 3.0
+GT1_POWER = 0.80
+PROBE_STEP_SCALE = 0.1
+TUNE_DISTILL_STEP_SCALE = 0.25
+
+# 设计 §6 的整段墙钟，dry-run 在逐步估算之外另报这组数。
+STAGE_WALL_H = {
+    "probe": 0.5,
+    "dev-tune": 1.6,
+    "dev-distill": 2.0 + 0.75 + 0.47,
+}
+
+
+HEADS_CACHE_SEG_PER_S = 54.0   # 学生前向抽取并缓存特征（按 54 段/秒）
+HEADS_TRAIN_STEP_PER_S = 100.0  # 仅更新读出头参数的优化器步速（按 100 步/秒估算）
+
+
+def steps_for(n_clips: int, epochs: int, batch: int = BATCH) -> int:
+    return max(1, int(epochs) * (int(n_clips) // int(batch)))
+
+
+def wall_seconds(n_clips: int, epochs: int, *, kind: str = "train", batch: int = BATCH) -> float:
+    """按设计里的每秒段数估算墙钟，只用于 dry-run。
+
+    对于 heads 格子，学生模型已冻结，耗时按「缓存一次学生特征 + 只训读出头」估算；
+    单头耗时约 25–89 s（平均约 50 s），dev-distill 54 个读出头合计约 0.81 h（对照设计 §6 的 0.75 h）；
+    待 probe 实测后校准覆盖。
+    """
+    if kind == "heads":
+        steps = steps_for(n_clips, epochs, batch)
+        cache_s = float(n_clips / HEADS_CACHE_SEG_PER_S)
+        train_s = float(steps / HEADS_TRAIN_STEP_PER_S)
+        return cache_s + train_s
+    return float(n_clips * epochs / SEG_PER_S)
+
+
+def scaled_epochs(design_epochs: int, scale: float) -> int:
+    return max(1, int(round(design_epochs * scale)))
+
+
+def normal_ppf(p: float) -> float:
+    """标准正态分位数。Acklam 近似，足够用来锁定功效公式。"""
+    if not 0.0 < p < 1.0:
+        raise ValueError(f"probability out of range: {p}")
+    a = (
+        -3.969683028665376e01,
+        2.209460984245205e02,
+        -2.759285104469687e02,
+        1.383577518672690e02,
+        -3.066479806614716e01,
+        2.506628277459239e00,
+    )
+    b = (
+        -5.447609879822406e01,
+        1.615858368580409e02,
+        -1.556989798598866e02,
+        6.680131188771972e01,
+        -1.328068155288572e01,
+    )
+    c = (
+        -7.784894002430293e-03,
+        -3.223964580411365e-01,
+        -2.400758277161838e00,
+        -2.549732539343734e00,
+        4.374664141464968e00,
+        2.938163982698783e00,
+    )
+    d = (
+        7.784695709041462e-03,
+        3.224671290700398e-01,
+        2.445134137142996e00,
+        3.754408661907416e00,
+    )
+    plow = 0.02425
+    if p < plow:
+        q = math.sqrt(-2.0 * math.log(p))
+        num = (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5])
+        den = ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0)
+        return num / den
+    if p > 1.0 - plow:
+        q = math.sqrt(-2.0 * math.log(1.0 - p))
+        num = (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5])
+        den = ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0)
+        return -(num / den)
+    q = p - 0.5
+    r = q * q
+    num = (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q
+    den = (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1.0)
+    return num / den
+
+
+def worlds_for_power(
+    sigma_world: float,
+    *,
+    effect: float = GT1_EFFECT,
+    level: float = GT1_LEVEL,
+    power: float = GT1_POWER,
+    cap: int = FINAL_WORLD_CAP,
+) -> dict[str, float | int | None]:
+    """GT1：真效应为 ``effect`` 时，98.3% 区间下界大于 0 的功效达到 ``power`` 所需世界数。
+
+    ``sigma_world`` 是配对差值的世界级标准差。区间用等尾分位，所以正态临界值取
+    ``(1-level)/2`` 而不是 ``1-level``。功效项再加 ``normal_ppf(power)``。
+    设计补记把 ``s5p1-final`` 封在 ``cap`` 个世界；超出的数仍记在 ``n_uncapped``。
+    """
+    if sigma_world < 0 or effect <= 0 or not 0.0 < power < 1.0:
+        raise ValueError("sigma, effect and power are out of range")
+    z_ci = normal_ppf(1.0 - (1.0 - level) / 2.0)
+    z_pow = normal_ppf(power)
+    if sigma_world == 0.0:
+        n_uncapped = 1
+    else:
+        n_uncapped = int(math.ceil((sigma_world * (z_ci + z_pow) / effect) ** 2))
+    return {
+        "n_uncapped": n_uncapped,
+        "n_worlds": min(n_uncapped, int(cap)),
+        "capped": bool(n_uncapped > cap),
+        "effect": float(effect),
+        "level": float(level),
+        "power": float(power),
+        "sigma_world": float(sigma_world),
+        "z_ci": float(z_ci),
+        "z_power": float(z_pow),
+    }
+
+
+def _mean(rows: list[float]) -> float:
+    if not rows:
+        raise ValueError("no rows to average")
+    return float(sum(rows) / len(rows))
+
+
+def select_a_star(rows: list[dict]) -> dict:
+    """L=64 的 R2 AP：先在蒸馏种子内平均读出种子，再在蒸馏种子间平均。
+
+    平局按 A1 < A2 < A3 取靠前的臂。
+    """
+    buckets: dict[str, dict[int, list[float]]] = {arm: {} for arm in ARM_ORDER}
+    for row in rows:
+        arm = str(row["arm"])
+        if arm not in buckets:
+            raise ValueError(f"unexpected arm {arm!r}")
+        seed = int(row["distill_seed"])
+        buckets[arm].setdefault(seed, []).append(float(row["r2_ap"]))
+    scored = []
+    for arm in ARM_ORDER:
+        per_distill = [_mean(values) for values in buckets[arm].values()]
+        if not per_distill:
+            raise ValueError(f"arm {arm} has no rows")
+        scored.append((arm, _mean(per_distill)))
+    best_score = max(score for _arm, score in scored)
+    tied = [arm for arm, score in scored if score == best_score]
+    chosen = next(arm for arm in ARM_ORDER if arm in tied)
+    return {"arm": chosen, "score": best_score, "per_arm": {arm: score for arm, score in scored}, "tied": tied}
+
+
+def choose_value(rows: list[dict], value_key: str) -> dict:
+    """同一取值先对 R2 AP 取平均，再按平均分选；平局取更小的取值。"""
+    groups: dict[float, list[float]] = {}
+    for row in rows:
+        groups.setdefault(float(row[value_key]), []).append(float(row["r2_ap"]))
+    averaged = [{value_key: key, "r2_ap": _mean(values)} for key, values in groups.items()]
+    return choose_smaller(averaged, value_key)
+
+
+def choose_smaller(rows: list[dict], value_key: str) -> dict:
+    """R2 AP 高者胜；平局取 ``value_key`` 更小的那个。"""
+    if not rows:
+        raise ValueError("no rows")
+    best = max(float(row["r2_ap"]) for row in rows)
+    tied = [row for row in rows if float(row["r2_ap"]) == best]
+    tied.sort(key=lambda row: float(row[value_key]))
+    winner = tied[0]
+    return {"value": float(winner[value_key]), "r2_ap": float(winner["r2_ap"]), "tied": len(tied)}
+
+
+def _cell(cell_id: str, kind: str, **fields) -> dict:
+    n_clips = int(fields.pop("n_clips"))
+    epochs = int(fields.pop("epochs"))
+    batch = int(fields.pop("batch", BATCH))
+    fields.update(
+        {
+            "cell_id": cell_id,
+            "kind": kind,
+            "n_clips": n_clips,
+            "epochs": epochs,
+            "batch_size": batch,
+            "steps": steps_for(n_clips, epochs, batch),
+            "wall_s_est": wall_seconds(n_clips, epochs, kind=kind, batch=batch),
+        }
+    )
+    return fields
+
+
+def stage_cells(stage: str, *, pool_worlds: int = POOL_WORLDS, lab_worlds: int = LAB_WORLDS) -> list[dict]:
+    """该阶段要跑的训练格。smoke 的格由运行器另列（固定 2 步）。"""
+    if stage == "smoke":
+        return []
+    pool_clips = pool_worlds * CLIPS_PER_WORLD
+    if stage == "probe":
+        cells = []
+        distill_epochs = scaled_epochs(DISTILL_EPOCHS, PROBE_STEP_SCALE)
+        for arm in ARM_ORDER:
+            cells.append(_cell(
+                f"probe-distill-{arm}-s0", "distill", arm=arm, seed=0, lr=1e-3,
+                n_clips=pool_clips, epochs=distill_epochs, partition="s5p1-pool",
+            ))
+        for label_n, worlds in L_WORLDS.items():
+            epochs = scaled_epochs(SUPER_EPOCHS[label_n], PROBE_STEP_SCALE)
+            n_clips = worlds * CLIPS_PER_WORLD
+            cells.append(_cell(
+                f"probe-A0-L{label_n}-s0", "supervised", arm="A0", seed=0, lr=1e-3,
+                label_n=label_n, n_clips=n_clips, epochs=epochs, partition="s5p1-lab",
+            ))
+        cells.append(_cell(
+            "probe-A4-L512-s0", "supervised", arm="A4", seed=0, lr=1e-3, eta=0.5,
+            label_n=512, n_clips=L_WORLDS[512] * CLIPS_PER_WORLD,
+            epochs=scaled_epochs(SUPER_EPOCHS[512], PROBE_STEP_SCALE), partition="s5p1-lab",
+        ))
+        cells.append(_cell(
+            "probe-A0R-L512-s0", "supervised", arm="A0-R", seed=0, lr=1e-3, tau=0.02,
+            label_n=512, n_clips=L_WORLDS[512] * CLIPS_PER_WORLD,
+            epochs=scaled_epochs(SUPER_EPOCHS[512], PROBE_STEP_SCALE), partition="s5p1-lab",
+        ))
+        for arm in ARM_ORDER:
+            for label_n, worlds in L_WORLDS.items():
+                cells.append(_cell(
+                    f"probe-heads-{arm}-L{label_n}-s0", "heads", arm=arm, seed=0,
+                    distill_seed=0, readout_seed=0, lr=1e-3, label_n=label_n,
+                    n_clips=worlds * CLIPS_PER_WORLD,
+                    epochs=scaled_epochs(SUPER_EPOCHS[label_n], PROBE_STEP_SCALE),
+                    partition="s5p1-lab",
+                ))
+        return cells
+    if stage == "dev-tune":
+        cells = []
+        epochs = scaled_epochs(DISTILL_EPOCHS, TUNE_DISTILL_STEP_SCALE)
+        for lr in DISTILL_LRS:
+            cells.append(_cell(
+                f"tune-distill-A2-lr{lr}", "distill", arm="A2", seed=0, lr=lr,
+                n_clips=pool_clips, epochs=epochs, partition="s5p1-pool", role="distill_lr",
+            ))
+        for label_n, worlds in L_WORLDS.items():
+            for lr in SUPER_LRS:
+                cells.append(_cell(
+                    f"tune-A0-L{label_n}-lr{lr}", "supervised", arm="A0", seed=0, lr=lr,
+                    label_n=label_n, n_clips=worlds * CLIPS_PER_WORLD,
+                    epochs=SUPER_EPOCHS[label_n], partition="s5p1-lab", role="supervised_lr",
+                ))
+        for eta in ETAS:
+            cells.append(_cell(
+                f"tune-A4-eta{eta}", "supervised", arm="A4", seed=0, lr=None, eta=eta,
+                label_n=512, n_clips=L_WORLDS[512] * CLIPS_PER_WORLD,
+                epochs=SUPER_EPOCHS[512], partition="s5p1-lab", role="eta",
+            ))
+        return cells
+    if stage == "dev-distill":
+        cells = []
+        for arm in ARM_ORDER:
+            for seed in (0, 1):
+                cells.append(_cell(
+                    f"distill-{arm}-s{seed}", "distill", arm=arm, seed=seed, lr=None,
+                    n_clips=pool_clips, epochs=DISTILL_EPOCHS, partition="s5p1-pool",
+                ))
+        for arm in ARM_ORDER:
+            for distill_seed in (0, 1):
+                for label_n, worlds in L_WORLDS.items():
+                    for readout_seed in (0, 1, 2):
+                        cells.append(_cell(
+                            f"heads-{arm}-d{distill_seed}-L{label_n}-r{readout_seed}",
+                            "heads", arm=arm, seed=readout_seed, distill_seed=distill_seed,
+                            readout_seed=readout_seed, lr=None, label_n=label_n,
+                            n_clips=worlds * CLIPS_PER_WORLD, epochs=SUPER_EPOCHS[label_n],
+                            partition="s5p1-lab",
+                        ))
+        for seed in (0, 1, 2):
+            cells.append(_cell(
+                f"A0-L64-s{seed}", "supervised", arm="A0", seed=seed, lr=None,
+                label_n=64, n_clips=L_WORLDS[64] * CLIPS_PER_WORLD,
+                epochs=SUPER_EPOCHS[64], partition="s5p1-lab",
+            ))
+        return cells
+    raise ValueError(f"unknown stage {stage!r}")
+
+
+def summarize_stage(stage: str, cells: list[dict]) -> dict:
