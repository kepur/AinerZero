+        linear_arm,
+        train_dir,
+        holdout_worlds=None,
+        n_samples=100,
+        seed_namespace="s2p1-train-v1|probe",
+    )
+    pred_file = probe_from_file.predict(linear_arm.encode(lp.featurize_obs(test_obs, 1)))
+    np.testing.assert_allclose(pred_file, np.array([5.0, 5.0]), atol=0.1)
